# Production settings for Los Sueños. Copy to .env on the server and fill in the blanks.
# Never commit the real .env file, and never share it: it contains secrets.

APP_NAME="Los Sueños"
APP_ENV=production
APP_DEBUG=false                 # must be false on a live site
APP_KEY=                        # run: php artisan key:generate
APP_URL=https://YOUR-DOMAIN     # exact public address; used in the sitemap and share previews
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
VITE_APP_NAME="${APP_NAME}"

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database (MySQL recommended). Give this user rights on this one database only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lossuenos
DB_USERNAME=lossuenos
DB_PASSWORD=

# Sessions: stored in the database so they can be ended when a person is deactivated or their password is reset.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true      # cookies only travel over HTTPS
SESSION_SAME_SITE=lax
BCRYPT_ROUNDS=12

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mail is needed for password-reset links. Use your school's or provider's SMTP details.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@YOUR-DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Hardening (see docs/SECURITY.md)
FORCE_HTTPS=true
SECURITY_HSTS=false             # switch to true once HTTPS works on every page
SECURITY_CSP=report-only        # later: enforce
TRUSTED_PROXIES=                # only if behind a load balancer / reverse proxy, e.g. 10.0.0.5 or *

# Backups
BACKUP_PATH=                    # leave empty for storage/app/backups
BACKUP_KEEP=14
